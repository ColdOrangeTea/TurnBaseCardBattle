  resultA: "\u5C0F\u5B69\u6210\u529F\u7684\u8EB2\u904E\u4E86\u602A\u7269\u3002 \u5B69\u5B50\u5011\u5FC3\u5B58\u611F\u6FC0\u7684\u5411\u4F60\u9053\u8B1D\u3002"
