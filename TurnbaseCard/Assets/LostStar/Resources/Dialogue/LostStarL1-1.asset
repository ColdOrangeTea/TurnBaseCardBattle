  - text: "\u2026\u60A8\u7684\u7236\u89AA\u662F\u500B\u5049\u5927\u7684\u4EBA\uFF0C\u4ED6\u5E36\u9818\u6211\u5011\u4E00\u8D77\u7D93\u6B77\u8A31\u591A\u56F0\u96E3\u548C\u6311\u6230\u3002"
