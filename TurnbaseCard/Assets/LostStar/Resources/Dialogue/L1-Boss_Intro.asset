    portrait: {fileID: 0}
    spineExpression: 
  - text: "\u770B\u554A\uFF0C\u9019\u5C31\u662F<color=#9C79D1>\u4F0A\u5A53</color>\u58AE\u5165\u6DF1\u6DF5\u7684\u6A21\u6A23\u3002"
