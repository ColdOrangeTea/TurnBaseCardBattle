    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u756B\u9762\u4E2D\u592E\u662F<color=#84C1FF>\u672C\u56DE\u5408\u62BD\u5230\u7684\u5361\u7247</color>\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u756B\u9762\u6B63\u4E0B\u65B9\u662F<color=#84C1FF>\u672C\u56DE\u5408\u9AB0\u5B50\u9AB0\u5230\u7684\u6578\u5B57</color>\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u73FE\u5728\u628A\u9AB0\u5B50\u62D6\u52D5\u5230\u5361\u7247\u4E0A\u4F7F\u7528\u770B\u770B\u5427\u3002"
