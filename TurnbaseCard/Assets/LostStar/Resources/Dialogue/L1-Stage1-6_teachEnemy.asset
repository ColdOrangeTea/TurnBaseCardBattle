    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u756B\u9762\u53F3\u4E0A\u65B9\u662F<color=#EA0000>\u602A\u7269</color>\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u756B\u9762\u5DE6\u4E0B\u65B9\u662F<color=#84C1FF>\u60A8\u7684\u72C0\u614B</color>\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
