  dialogueTextFile: {fileID: 4900000, guid: d1fa808caae07fb49960ac8508f72438, type: 3}
  lines:
  - text: "\u525B\u624D\u505A\u5F97\u5F88\u597D\uFF0C\u611F\u89BA\u60A8\u638C\u63E1\u5230\u8A23\u7AC5\u4E86\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u6B63\u597D\u8001\u5A46\u5A46\u59D4\u8A17\u7684\u4EFB\u52D9\u4E5F\u5B8C\u6210\u4E86\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u4EFB\u52D9\u5B8C\u6210\u5F8C\uFF0C\u661F\u661F\u6703\u81EA\u5DF1\u56DE\u5831\u4EFB\u52D9\uFF0C\u4E26\u9818\u53D6\u4EFB\u52D9\u734E\u52F5\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u662F\u4E0D\u662F\u5341\u5206\u65B9\u4FBF\u5462\uFF1F"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u8A71\u8AAA\u56DE\u4F86\uFF0C<color=#9C79D1>\u8056\u570B\uFF0D\u4F0A\u5A53</color>\u51FA\u73FE<color=#FF3333>\u602A\u7269</color>\u4E00\u4E8B\u9084\u662F\u5F88\u5947\u602A\u2026\u6211\u5011\u5F97\u53BB\u770B\u770B\u624D\u884C\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
