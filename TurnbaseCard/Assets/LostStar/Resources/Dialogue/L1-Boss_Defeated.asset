  dialogueTextFile: {fileID: 4900000, guid: c7655e92ff95fbf4a917f8aa3ab52d7e, type: 3}
  lines:
  - text: "\u54B3\u54C8\u3001\u2026\uFF01\uFF01"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 5ba1d06fd98958e42b4343a89ae575a8, type: 2}
    themeColorIndex: 0
    speaker: 2
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Closeeyes
  - text: "\u2026|pause|\u5DF2\u7D93\u4E00\u5E74\u4E86\u5C0D\u5427\u2026|pause|\u81EA\u5F9E\u4F60\u7236\u89AA\u6B9E\u843D\u5F8C\uFF0C|pause|\u4E00\u5207\u90FD\u8B8A\u4E86\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 5ba1d06fd98958e42b4343a89ae575a8, type: 2}
    themeColorIndex: 0
    speaker: 2
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Watch
  - text: "\u2026\u2026\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 5ba1d06fd98958e42b4343a89ae575a8, type: 2}
    themeColorIndex: 0
    speaker: 2
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Closeeyes
  - text: "\u2026\u2026|pause|\u6703\u6709\u9019\u6A23\u7684\u7D50\u5C40\u90FD\u662F\u56E0\u70BA\u4F60\uFF0C<color=#84C1FF>\u8CFD\u62C9\u83F2\u65AF</color>\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 5ba1d06fd98958e42b4343a89ae575a8, type: 2}
    themeColorIndex: 0
    speaker: 2
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Closeeyes
  - text: "\uFF08\u5730\u9762\u958B\u59CB\u9707\u52D5\uFF0C\u7A7A\u6C23\u4F3C\u4E4E\u4E5F\u5728\u986B\u6296\uFF09"
    pauseDuration: 0
    useCharacterStyle: 0
    characterStyle: {fileID: 0}
    themeColorIndex: 0
    speaker: 14
    displayName: ' '
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: 
  - text: "<color=#84C1FF>\u8CFD\u62C9\u83F2\u65AF</color>\u2026|pause|\u6709\u6A5F\u6703\u518D\u76F8\u898B\u5427\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 5ba1d06fd98958e42b4343a89ae575a8, type: 2}
    themeColorIndex: 0
    speaker: 2
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Watch
  - text: "\u5E0C\u671B\u5230\u90A3\u6642\u5019\uFF0C\u4F60\u7684\u60B2\u50B7\u5DF2\u7D93\u4E0D\u518D\u5982\u6D2A\u6C34\u541E\u566C\u842C\u7269\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 5ba1d06fd98958e42b4343a89ae575a8, type: 2}
    themeColorIndex: 0
    speaker: 2
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Closeeyes
  - text: "\uFF08\u9707\u52D5\u6108\u52A0\u5287\u70C8\uFF0C\u5967\u862D\u5A1C\u7684\u80FD\u91CF\u5982\u6F6E\u6C34\u822C\u6E67\u73FE\uFF0C\u8000\u773C\u7684\u5149\u8292\u5C07\u5979\u5B8C\u5168\u541E\u566C\uFF09"
    pauseDuration: 0
    useCharacterStyle: 0
    characterStyle: {fileID: 0}
    themeColorIndex: 0
    speaker: 14
    displayName: ' '
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: 
  - text: "\uFF08\u4F60\u9010\u6F38\u7121\u6CD5\u7AD9\u7A69\u8173\u6B65\u2026\u4F60\u807D\u5230\u9060\u65B9\u6709\u4EBA\u5728\u558A\u4F60\u7684\u540D\u5B57\uFF09"
    pauseDuration: 0
    useCharacterStyle: 0
    characterStyle: {fileID: 0}
    themeColorIndex: 0
    speaker: 14
    displayName: ' '
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: 
  - text: "\u5C11\u723A\uFF01\u60A8\u6C92\u4E8B\u5427\u5C11\u723A\uFF01"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Watch
  - text: "\u5967\u862D\u5A1C\u2026\u9019\u662F|pause|\u2026\u8981\u4F7F\u7528\u8D85\u65B0\u661F\u7206\u70B8\u55CE\uFF1F\uFF01"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Surprise
  - text: "\u4E0D\u884C\uFF0C\u4F86\u4E0D\u53CA\u53EC\u56DE\u5176\u4ED6\u5718\u54E1\u4E86\uFF01"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Watch
  - text: "\u6211\u5011\u5148\u56DE\u5230\u6BCD\u8266\u4E0A\uFF01\uFF01\u5C11\u723A\uFF0C\u5FEB\u8D70\uFF01"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
