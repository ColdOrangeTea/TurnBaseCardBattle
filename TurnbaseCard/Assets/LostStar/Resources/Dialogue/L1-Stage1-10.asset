    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u8207\u6B64\u540C\u6642\uFF0C\u7576\u5E73\u6642\u5C45\u6C11\u5011\u6709\u9700\u8981\u5E6B\u5FD9\u7684\u5730\u65B9\uFF0C\u6211\u5011\u4E5F\u6703\u4F38\u51FA\u63F4\u624B\u3002"
    pauseDuration: 0
    useCharacterStyle: 1
    characterStyle: {fileID: 11400000, guid: 6c4b3ab1de92fba4b9c909ea4cf6f8fc, type: 2}
    themeColorIndex: 0
    speaker: 1
    displayName: 
    customNameColor: {r: 1, g: 1, b: 1, a: 1}
    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u9019\u4FBF\u662F<color=#84C1FF>\u5F57\u661F\u5718</color>\u8207<color=#9C79D1>\u661F\u7403\u5C45\u6C11\u5011</color>\u4E92\u52D5\u7684\u65B9\u5F0F\u4E86\u3002"
