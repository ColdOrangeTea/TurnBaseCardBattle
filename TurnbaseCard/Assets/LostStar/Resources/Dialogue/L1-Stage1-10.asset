    portrait: {fileID: 0}
    spineExpression: Headdown
  - text: "\u88E1\u9762\u5982\u679C\u6B63\u597D\u662F\u9700\u8981\u7684\u8CC7\u6E90\u5C31\u62FF\u53BB\u5427\u3002"
